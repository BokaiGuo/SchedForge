  moe {
sfe.moe_executable version=0.4.0 target=native-cpu
hardware=x86_64 AVX2 vector=8 registers=16 cpus=20
config tokens<= 4 hidden=16 intermediate=32 experts=4 top_k=2
graph @model {
  %v0 = tensor.input : tensor<Tx16xf32, layout=row_major>
  %v1 = tensor.constant : tensor<16x4xf32, layout=row_major>
  %v2 = tensor.constant : tensor<4x16x32xf32, layout=row_major>
  %v3 = tensor.constant : tensor<4x16x32xf32, layout=row_major>
  %v4 = tensor.constant : tensor<4x32x16xf32, layout=row_major>
  %v5 = tensor.matmul %v0 %v1 : tensor<Tx4xf32, layout=row_major>
  %v6 = tensor.softmax %v5 : tensor<Tx4xf32, layout=row_major>
  %v7 = tensor.topk %v6 {k=2} : tensor<Tx2xi32, layout=row_major>
  %v8 = tensor.topk %v6 {k=2} : tensor<Tx2xf32, layout=row_major>
  %v9 = moe.histogram %v7 : tensor<4xi32, layout=row_major>
  %v10 = moe.prefix_sum %v9 : tensor<5xi32, layout=row_major>
  %v11 = moe.dispatch %v0 %v7 %v8 %v10 : tensor<assignmentsx16xf32, layout=row_major>
  %v12 = moe.grouped_matmul %v11 %v10 %v2 : tensor<assignmentsx32xf32, layout=row_major>
  %v13 = moe.grouped_matmul %v11 %v10 %v3 : tensor<assignmentsx32xf32, layout=row_major>
  %v14 = tensor.swiglu %v12 %v13 : tensor<assignmentsx32xf32, layout=row_major>
  %v15 = moe.grouped_matmul %v14 %v10 %v4 : tensor<assignmentsx16xf32, layout=row_major>
  %v16 = moe.combine %v15 %v7 %v8 : tensor<Tx16xf32, layout=row_major>
  func.return %v16
}
moe.program {
  %logits = tensor.matmul %x %router_weight {shape=TxE}
  %scores = tensor.softmax %logits {axis=experts}
  %expert_ids,%expert_weights = tensor.topk %scores {k=2}
  %counts = moe.histogram %expert_ids {experts=4}
  %offsets = moe.prefix_sum %counts {exclusive=true}
  %permuted,%token_ids = moe.dispatch %x %expert_ids %offsets {stable=true}
  %h = moe.grouped_matmul.w1 %permuted %offsets %W1 {variable_m=true}
  %g = moe.grouped_matmul.w3 %permuted %offsets %W3 {variable_m=true}
  %a = tensor.swiglu %h %g {in_place=%h}
  %expert_result = moe.grouped_matmul.w2 %a %offsets %W2 {variable_m=true}
  %y = moe.weighted_combine %expert_result %token_ids %expert_weights {topk_reduce=true}
}
segmented_type !sfg.segmented_tensor<values=tensor<?x16xf32>, segments=4>
moe.schedule {
  strategy bucketed-grouped
  task_scheduling load-aware-split
  bucket_m [4,16,64]
  split_threshold 32
  threads 2
  router.fuse_topk true
  dispatch.histogram_prefix true
  combine.fuse_weight true
}
guards {
  0 < T
  T <= 4
  assignments == T * 2
}
moe.memory naive=4468 workspace=3444 routing=116 segmented=512
