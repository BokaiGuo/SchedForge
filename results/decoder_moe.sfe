  %v10 = tensor.matmul %v8 %v3 : tensor<4x8xf32, layout=row_major>
  %v11 = tensor.matmul %v8 %v4 : tensor<4x8xf32, layout=row_major>
  %v12 = tensor.rope %v9 : tensor<4x16xf32, layout=row_major>
  %v13 = tensor.rope %v10 : tensor<4x8xf32, layout=row_major>
  %v14 = tensor.matmul %v12 %v5 : tensor<4x16xf32, layout=row_major>
  %v15 = tensor.add %v14 %v0 : tensor<4x16xf32, layout=row_major>
  %v16 = tensor.rms_norm %v15 %v6 : tensor<4x16xf32, layout=row_major>
  %v17 = tensor.matmul %v16 %v7 : tensor<4x4xf32, layout=row_major>
  %v18 = moe.combine %v16 %v17 : tensor<4x16xf32, layout=row_major>
  %v19 = tensor.add %v18 %v15 : tensor<4x16xf32, layout=row_major>
  func.return %v19
}
}
canonical {
graph @model {
  %v0 = tensor.input : tensor<4x16xf32, layout=row_major>
  %v1 = tensor.constant : tensor<16xf32, layout=row_major>
