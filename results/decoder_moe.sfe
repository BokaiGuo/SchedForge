decoder.fusion qkv=1 gate_up=0 rope=1
constants {
  constant @packed_qkv_weight logical=[16,16,8,8] packed=[16,32] layout=qkv_interleaved_nr bytes=2048
}
decoder.memory naive=7028 workspace=3444
kernels {
  qkv {
func @matmul(%A, %B, %bias, %C) {
  scf.parallel %ii = 0 to M step 16 threads=2 pinned=1 {
    scf.for %jj = 0 to N step 64 {
      scf.for %i = 0 to min(ii+16,M) step 4 {
        scf.for %j = 0 to min(jj+64,N) step 8 {
          %acc = vector.accumulator.init : vector<8xf32>
          scf.for %kk = 0 to K step 32 {
            scf.for %k = 0 to min(kk+32,K) step 1 {
              %a = memref.load %A[%i,%k]
              %b = vector.load %B[%k,%j] : vector<8xf32>
              %a_vec = vector.broadcast %a : vector<8xf32>
              %acc = vector.fma %a_vec,%b,%acc : vector<8xf32>
            }
          }
          vector.store %acc -> %C[%i,%j] : vector<8xf32>
        }
      }
    }
  }
}
  }
  attention {
sfe.attention_executable version=0.5.0 strategy=materialized
hardware=x86_64 AVX2 vector=8 registers=16 cpus=20
config B=1 Hq=4 Hkv=2 Sq<=4 Sk<=4 D=4 Dv=4 causal=true
graph @model {
  %v0 = tensor.input : tensor<1x4xSqx4xf32, layout=row_major>
  %v1 = tensor.input : tensor<1x2xSkx4xf32, layout=row_major>
  %v2 = tensor.input : tensor<1x2xSkx4xf32, layout=row_major>
  %v3 = attention.sdpa %v0 %v1 %v2 {causal=true, semantic=scaled_dot_product_attention} : tensor<1x4xSqx4xf32, layout=row_major>
  func.return %v3
}
attention.schedule {
  qtile 4
  kvtile 4
  qk_micro 4x8
  pv_micro 4x8
  softmax_vector 8
  pack_k true
  pack_v false
  prefetch_k 2
  prefetch_v 2
  threads 2
}
tile.pipeline @attention {
  %scores = attention.qk %Q_tile, %K_tile
  %scaled = attention.scale %scores
  %masked = attention.causal_mask %scaled
  %row_max = reduce.max %masked
  %new_max = vector.max %running_max, %row_max
  %probability = vector.exp %masked - %new_max
  %block_sum = reduce.sum %probability
  %rescaled = attention.rescale %running_state, %new_max
  %online = attention.online_softmax %probability, %block_sum
  %output = attention.pv %probability, %V_tile
  %normalized = vector.div %output, %denominator
  tile.yield %output
}
guards {
  0 < Sq
  Sq <= 4
  0 < Sk
  Sk <= 4
  Hq % Hkv == 0
}
attention.memory temporary=512 score=256 probability=256 online_state=0
attention.simulation flops=640 bytes_read=1024 bytes_written=768 arithmetic_intensity=0.357143 temporary=512 qk_tiles=4 skipped_causal_tiles=0 score_evaluations=40 exp_evaluations=56 reduction_operations=80 l2_traffic=2304 llc_traffic=1792 l2_hit_rate=0.222222 llc_hit_rate=0
qk_loop {
func @matmul(%A, %B, %bias, %C) {
  %packed_b = buffer.alloc -> %packedB
  buffer.pack %B -> %packedB
  scf.for %ii = 0 to M step 4 {
    scf.for %jj = 0 to N step 4 {
      scf.for %i = 0 to min(ii+4,M) step 4 {
        scf.for %j = 0 to min(jj+4,N) step 8 {
          %acc = vector.accumulator.init : vector<8xf32>
          scf.for %kk = 0 to K step 4 {
            scf.for %k = 0 to min(kk+4,K) step 1 {
              memref.prefetch %packedB[%k,%j] distance=2
              %a = memref.load %A[%i,%k]
              %b = vector.load %packedB[%k,%j] : vector<8xf32>
              %a_vec = vector.broadcast %a : vector<8xf32>
              %acc = vector.fma %a_vec,%b,%acc : vector<8xf32>
            }
          }
          vector.store %acc -> %C[%i,%j] : vector<8xf32>
        }
      }
    }
  }
}
}
pv_loop {
func @matmul(%A, %B, %bias, %C) {
  scf.for %ii = 0 to M step 4 {
    scf.for %jj = 0 to N step 4 {
      scf.for %i = 0 to min(ii+4,M) step 4 {
        scf.for %j = 0 to min(jj+4,N) step 8 {
          %acc = vector.accumulator.init : vector<8xf32>
          scf.for %kk = 0 to K step 4 {
            scf.for %k = 0 to min(kk+4,K) step 1 {
              memref.prefetch %B[%k,%j] distance=2
              %a = memref.load %A[%i,%k]
              %b = vector.load %B[%k,%j] : vector<8xf32>
              %a_vec = vector.broadcast %a : vector<8xf32>
              %acc = vector.fma %a_vec,%b,%acc : vector<8xf32>
            }
          }
          vector.store %acc -> %C[%i,%j] : vector<8xf32>
        }
      }
    }
  }
}
}
