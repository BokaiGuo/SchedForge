  %v6 = tensor.add %v5 %v2 : tensor<16x128xf32, layout=row_major>
  %v7 = tensor.gelu %v6 : tensor<16x128xf32, layout=blocked<6x16>>
  %v8 = tensor.matmul %v7 %v3 : tensor<16x64xf32, layout=row_major>
  %v9 = tensor.add %v8 %v4 : tensor<16x64xf32, layout=row_major>
  %v10 = tensor.add %v9 %v0 : tensor<16x64xf32, layout=row_major>
  func.return %v10
}
structured_compute {
  tensor.compute @linear1 iterators(i:parallel, j:parallel, k:reduction) maps(A(i,k), B(k,j), C(i,j)) { C(i,j) += A(i,k) * B(k,j) }
  tensor.compute @bias1 iterators(i:parallel, j:parallel) maps(input(i,j), output(i,j)) { tensor.add }
  tensor.compute @gelu iterators(i:parallel, j:parallel) maps(input(i,j), output(i,j)) { tensor.gelu }
  tensor.compute @linear2 iterators(i:parallel, j:parallel, k:reduction) maps(A(i,k), B(k,j), C(i,j)) { C(i,j) += A(i,k) * B(k,j) }
  tensor.compute @bias2 iterators(i:parallel, j:parallel) maps(input(i,j), output(i,j)) { tensor.add }
  tensor.compute @residual iterators(i:parallel, j:parallel) maps(input(i,j), output(i,j)) { tensor.add }
}
