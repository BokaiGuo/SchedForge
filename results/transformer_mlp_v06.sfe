func @matmul(%A, %B, %bias, %C) {
  scf.parallel %ii = 0 to M step 32 threads=4 pinned=1 {
    scf.for %jj = 0 to N step 64 {
      scf.for %i = 0 to min(ii+32,M) step 4 {
        scf.for %j = 0 to min(jj+64,N) step 8 {
          %acc = vector.accumulator.init : vector<8xf32>
          scf.for %kk = 0 to K step 32 {
            scf.for %k = 0 to min(kk+32,K) step 1 {
              %a = memref.load %A[%i,%k]
              %b = vector.load %B[%k,%j] : vector<8xf32>
              %a_vec = vector.broadcast %a : vector<8xf32>
              %acc = vector.fma %a_vec,%b,%acc : vector<8xf32>
            }
          }
          %acc = epilogue.add_bias %bias[%j] : vector<8xf32>
          %acc = epilogue.gelu %acc
          vector.store %acc -> %C[%i,%j] : vector<8xf32>
        }
      }
    }
  }
}
  }
