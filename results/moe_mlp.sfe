sfe.moe_executable version=0.4.0 target=native-cpu
hardware=x86_64 AVX2 vector=8 registers=16 cpus=20
config tokens<= 128 hidden=512 intermediate=2048 experts=8 top_k=2
graph @model {
  %v0 = tensor.input : tensor<Tx512xf32, layout=row_major>
  %v1 = tensor.constant : tensor<512x8xf32, layout=row_major>
  %v2 = tensor.constant : tensor<8x512x2048xf32, layout=row_major>
  %v3 = tensor.constant : tensor<8x512x2048xf32, layout=row_major>
  %v4 = tensor.constant : tensor<8x2048x512xf32, layout=row_major>
  %v5 = tensor.matmul %v0 %v1 : tensor<Tx8xf32, layout=row_major>
  %v6 = tensor.softmax %v5 : tensor<Tx8xf32, layout=row_major>
  %v7 = tensor.topk %v6 : tensor<Tx2xi32, layout=row_major>
  %v8 = tensor.topk %v6 : tensor<Tx2xf32, layout=row_major>
  %v9 = moe.histogram %v7 : tensor<8xi32, layout=row_major>
  %v10 = moe.prefix_sum %v9 : tensor<9xi32, layout=row_major>
  %v11 = moe.dispatch %v0 %v7 %v8 %v10 : tensor<assignmentsx512xf32, layout=row_major>
  %v12 = moe.grouped_matmul %v11 %v10 %v2 : tensor<assignmentsx2048xf32, layout=row_major>
  %v13 = moe.grouped_matmul %v11 %v10 %v3 : tensor<assignmentsx2048xf32, layout=row_major>
  %v14 = tensor.swiglu %v12 %v13 : tensor<assignmentsx2048xf32, layout=row_major>
  %v15 = moe.grouped_matmul %v14 %v10 %v4 : tensor<assignmentsx512xf32, layout=row_major>
  %v16 = moe.combine %v15 %v7 %v8 : tensor<Tx512xf32, layout=row_major>
  func.return %v16
}
moe.program {
  %logits = tensor.matmul %x %router_weight {shape=TxE}
  %scores = tensor.softmax %logits {axis=experts}
  %expert_ids,%expert_weights = tensor.topk %scores {k=2}
  %counts = moe.histogram %expert_ids {experts=8}
  %offsets = moe.prefix_sum %counts {exclusive=true}
  %permuted,%token_ids = moe.dispatch %x %expert_ids %offsets {stable=true}
  %h = moe.grouped_matmul.w1 %permuted %offsets %W1 {variable_m=true}
  %g = moe.grouped_matmul.w3 %permuted %offsets %W3 {variable_m=true}
  %a = tensor.swiglu %h %g {in_place=%h}
  %expert_result = moe.grouped_matmul.w2 %a %offsets %W2 {variable_m=true}
  %y = moe.weighted_combine %expert_result %token_ids %expert_weights {topk_reduce=true}
}
segmented_type !sfg.segmented_tensor<values=tensor<?x512xf32>, segments=8>
moe.schedule {
  strategy grouped
  task_scheduling load-aware-split
  bucket_m [4,16,64,128]
  split_threshold 16
  threads 8
  router.fuse_topk true
  dispatch.histogram_prefix true
  combine.fuse_weight true
}
guards {
  0 < T
  T <= 128
  assignments == T * 2
}
moe.memory naive=7605284 workspace=5508132 routing=3108 segmented=524288
expert_kernels {
  bucket M<=4 {
func @matmul(%A, %B, %bias, %C) {
  scf.for %ii = 0 to M step 16 {
    scf.for %jj = 0 to N step 64 {
      scf.for %i = 0 to min(ii+16,M) step 1 {
        scf.for %j = 0 to min(jj+64,N) step 16 {
          %acc = vector.accumulator.init : vector<8xf32>
          scf.for %kk = 0 to K step 16 {
            scf.for %k = 0 to min(kk+16,K) step 1 {
              %a = memref.load %A[%i,%k]
              %b = vector.load %B[%k,%j] : vector<8xf32>
              %a_vec = vector.broadcast %a : vector<8xf32>
              %acc = vector.fma %a_vec,%b,%acc : vector<8xf32>
            }
          }
          vector.store %acc -> %C[%i,%j] : vector<8xf32>
        }
      }
    }
  }
}
func @matmul(%A, %B, %bias, %C) {
  scf.for %ii = 0 to M step 16 {
    scf.for %jj = 0 to N step 64 {
      scf.for %i = 0 to min(ii+16,M) step 1 {
        scf.for %j = 0 to min(jj+64,N) step 16 {
          %acc = vector.accumulator.init : vector<8xf32>
          scf.for %kk = 0 to K step 16 {
            scf.for %k = 0 to min(kk+16,K) step 1 {
              %a = memref.load %A[%i,%k]
              %b = vector.load %B[%k,%j] : vector<8xf32>
              %a_vec = vector.broadcast %a : vector<8xf32>
              %acc = vector.fma %a_vec,%b,%acc : vector<8xf32>
            }
          }
          vector.store %acc -> %C[%i,%j] : vector<8xf32>
        }
      }
    }
  }
}
