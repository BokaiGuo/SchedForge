sfe.attention_executable version=0.5.0 strategy=auto-io-aware
hardware=x86_64 AVX2 vector=8 registers=16 cpus=20
config B=1 Hq=8 Hkv=8 Sq<=128 Sk<=128 D=64 Dv=64 causal=true
graph @model {
  %v0 = tensor.input : tensor<1x8xSqx64xf32, layout=row_major>
  %v1 = tensor.input : tensor<1x8xSkx64xf32, layout=row_major>
  %v2 = tensor.input : tensor<1x8xSkx64xf32, layout=row_major>
  %v3 = attention.sdpa %v0 %v1 %v2 : tensor<1x8xSqx64xf32, layout=row_major>
  func.return %v3
}
attention.schedule {
  qtile 32
  kvtile 32
  qk_micro 4x8
  pv_micro 4x8
  softmax_vector 8
  pack_k true
  pack_v false
  prefetch_k 2
  prefetch_v 2
  threads 8
}
tile.pipeline @attention {
  %scores = attention.qk %Q_tile, %K_tile
  %scaled = attention.scale %scores
  %masked = attention.causal_mask %scaled
  %row_max = reduce.max %masked
  %new_max = vector.max %running_max, %row_max
  %probability = vector.exp %masked - %new_max
  %block_sum = reduce.sum %probability
  %rescaled = attention.rescale %running_state, %new_max
  %online = attention.online_softmax %probability, %block_sum
  %output = attention.pv %probability, %V_tile
  %normalized = vector.div %output, %denominator
  tile.yield %output
}
guards {
  0 < Sq
  Sq <= 128
  0 < Sk
  Sk <= 128
  Hq % Hkv == 0
}
attention.memory temporary=100352 score=0 probability=0 online_state=100352
attention.simulation flops=1.69083e+07 bytes_read=786432 bytes_written=262144 arithmetic_intensity=16.125 temporary=100352 qk_tiles=80 skipped_causal_tiles=48 score_evaluations=66048 exp_evaluations=70144 reduction_operations=132096 l2_traffic=2.62144e+06 llc_traffic=1.04858e+06 l2_hit_rate=0.6 llc_hit_rate=0
qk_loop {
func @matmul(%A, %B, %bias, %C) {
  %packed_b = buffer.alloc -> %packedB
  buffer.pack %B -> %packedB
  scf.for %ii = 0 to M step 32 {
    scf.for %jj = 0 to N step 32 {
      scf.for %i = 0 to min(ii+32,M) step 4 {
        scf.for %j = 0 to min(jj+32,N) step 8 {
          %acc = vector.accumulator.init : vector<8xf32>
          scf.for %kk = 0 to K step 64 {
            scf.for %k = 0 to min(kk+64,K) step 1 {
              memref.prefetch %packedB[%k,%j] distance=2
              %a = memref.load %A[%i,%k]
              %b = vector.load %packedB[%k,%j] : vector<8xf32>
              %a_vec = vector.broadcast %a : vector<8xf32>
              %acc = vector.fma %a_vec,%b,%acc : vector<8xf32>
            }
          }
          vector.store %acc -> %C[%i,%j] : vector<8xf32>
        }
      }
    }
  }
}
}
pv_loop {
func @matmul(%A, %B, %bias, %C) {
  scf.for %ii = 0 to M step 32 {
    scf.for %jj = 0 to N step 64 {
      scf.for %i = 0 to min(ii+32,M) step 4 {
        scf.for %j = 0 to min(jj+64,N) step 8 {
          %acc = vector.accumulator.init : vector<8xf32>
          scf.for %kk = 0 to K step 32 {
            scf.for %k = 0 to min(kk+32,K) step 1 {
              memref.prefetch %B[%k,%j] distance=2
              %a = memref.load %A[%i,%k]
              %b = vector.load %B[%k,%j] : vector<8xf32>
              %a_vec = vector.broadcast %a : vector<8xf32>
              %acc = vector.fma %a_vec,%b,%acc : vector<8xf32>
            }
          }
          vector.store %acc -> %C[%i,%j] : vector<8xf32>
        }
      }
    }
  }
}
}
